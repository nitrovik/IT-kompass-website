# Kopier til .env.local lokalt. I produksjon legges verdiene inn hos vertstjenesten.

# Adressen nettsiden ligger på (brukes i sitemap, delingsbilder og canonical-lenker)
NEXT_PUBLIC_SITE_URL=https://www.itkompass.no

# E-post fra skjemaene sendes via Resend (resend.com)
RESEND_API_KEY=
# Avsender må være på et domene som er verifisert i Resend
RESEND_FROM="IT Kompass <no-reply@itkompass.no>"
# Hvem som skal motta henvendelsene
CONTACT_RECIPIENT=

# Spamvern fra Cloudflare Turnstile. Uten disse avvises alle skjemainnsendinger i produksjon.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Valgfritt – tomme felt skjuler funksjonen på nettsiden
# Plausible-besøksstatistikk (uten informasjonskapsler)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Møtebooking (f.eks. Cal.com) som vises på kontaktsiden
NEXT_PUBLIC_CAL_URL=
# Nedlastingslenke til fjernhjelpsverktøy, vises på supportsiden
REMOTE_HELP_URL=
# Live driftsstatus (JSON: { "services": [{ "name", "state", "detail" }] })
STATUS_API_URL=
